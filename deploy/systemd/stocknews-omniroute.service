# OmniRoute (the extraction LLM router), loopback only. It reads the project's .env from its working directory.
[Unit]
Description=OmniRoute LLM router for the stock-news pipeline
After=network-online.target
OnFailure=stocknews-notify@%n.service

[Service]
WorkingDirectory=@RELEASE@
Environment=OMNIROUTE_SERVER_HOST=127.0.0.1
Environment="PATH=@PATH@"
ExecStart=@OMNIROUTE@ serve --no-open
Restart=on-failure
# Stopping sends SIGTERM; exiting on it (code 143) is a normal stop, not a failure.
SuccessExitStatus=143
RestartSec=10

[Install]
WantedBy=default.target
