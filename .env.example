# =============================================================================
# Stock-News Pipeline — environment variables
# Copy to .env (`make setup` does this) and fill in real values. Never commit .env.
# Every variable has a sensible default; only the ones marked REQUIRED matter
# for a basic local run.
# =============================================================================

# --- Databases ---------------------------------------------------------------
# REQUIRED — the Docker Postgres from `make db-up`
LOCAL_DB_URL=postgresql://postgres:postgres@localhost:5432/stocknews
# Neon (laptop → cloud sync, needs write access). Leave empty to skip syncing.
NEON_DB_URL=
# What the public API reads. On Render use a READ-ONLY Neon role here.
# Locally, empty = NEON_DB_URL, then LOCAL_DB_URL.
API_DB_URL=
# NEON_SYNC_LOOKBACK_DAYS=3
# Dashboard accounts (users / user_sessions tables). Needs WRITE access, so on Render
# point it at a Neon role that can write only those two tables. Empty = the API DSN.
AUTH_DB_URL=

# --- Sign-in ----------------------------------------------------------------------
# "Continue with Google": an OAuth 2.0 Web client ID from Google Cloud Console
# (APIs & Services → Credentials), with your dashboard origin under "Authorized
# JavaScript origins". Empty = email + password only.
GOOGLE_CLIENT_ID=
# AUTH_SESSION_DAYS=30

# --- India market (RSS; Finviz covers US-listed stocks only) --------------------
# Comma-separated feeds. Empty = no Indian news. Default: Economic Times, Mint, Business Standard.
# INDIA_FEEDS=
# INDIA_MAX_AGE_HOURS=72

# --- Live quotes (API only; never exposed to the browser) ---------------------
FINNHUB_API_KEY=

# --- OmniRoute: local OpenAI-compatible router for extraction ----------------
# `omniroute serve` prints "Dashboard: http://localhost:20128" and
# "API Base: http://localhost:8000/v1" — this must be the API Base.
OMNIROUTE_API_URL=http://localhost:8000/v1
OMNIROUTE_MODEL=extraction-combo
# OMNIROUTE_REPORT_MODEL=            # combo for the report fallback (default: OMNIROUTE_MODEL)
# EXTRACTION_MAX_PER_RUN=150
# EXTRACTION_MAX_ATTEMPTS=3

# --- Ask the news (backend/ask.py) -------------------------------------------------
# An agent with tool calls: point ASK_MODEL at an OmniRoute combo of models that do them
# (e.g. gpt-oss-120b → gpt-oss-20b → ministral-14b). URL and key default to the OMNIROUTE_ ones.
# ASK_API_URL=
# ASK_API_KEY=
ASK_MODEL=ask-combo
# ASK_PER_USER_HOUR=10
# ASK_DAILY_TOTAL=200

# --- Daily report --------------------------------------------------------------
# Providers are tried in order until one succeeds:
#   anthropic  — Claude API (set ANTHROPIC_API_KEY); most reliable, works headless/cron
#   claude_web — Claude.ai in a browser (run `make claude-login` once; needs a display)
#   omniroute  — free models via OmniRoute; always-available fallback
REPORT_PROVIDERS=anthropic,claude_web,omniroute
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
# REPORT_MIN_ARTICLES=5
# REPORT_REFRESH_NEW_ARTICLES=15
# REPORT_TOP_PICKS=15                 # must-read stories the writer ranks ("Top picks" in the dashboard)

# Claude.ai browser profile — use a DEDICATED directory, not your everyday Chrome profile.
# CHROME_PROFILE_DIR=~/.config/stock-news-pipeline/claude-profile
# CLAUDE_HEADLESS=false
# CLAUDE_GOOGLE_ACCOUNT=you@gmail.com   # optional: auto-pick this account in the Google popup

# --- Body fetch ----------------------------------------------------------------
# FETCH_SKIP_DOMAINS=wsj.com,barrons.com,marketwatch.com,ft.com,bloomberg.com,investors.com

# --- API ----------------------------------------------------------------------
# Comma-separated allowed browser origins for the public API ("*" = any)
CORS_ORIGINS=*

# --- Alerts and backups (the scheduled job; see README "Running it day to day") ------
# A stage alerts after failing this many runs in a row (a crashed run alerts at once).
# ALERT_AFTER_FAILURES=2
# ALERT_DESKTOP=true
# Optional phone pushes: any URL that accepts a plain-text POST, e.g. https://ntfy.sh/<a-long-random-topic>
ALERT_WEBHOOK_URL=
# Optional dead-man's switch (e.g. a free healthchecks.io check): pinged after every run,
# so you also hear when runs stop happening (laptop off, scheduler broken).
HEALTHCHECK_URL=
# BACKUP_DIR=~/.local/share/stock-news-pipeline/backups
# BACKUP_KEEP=14

# --- Logging --------------------------------------------------------------------
# LOG_DIR=./logs
# LOG_LEVEL=INFO

# --- Readiness gate -------------------------------------------------------------
GATE_MIN_DAYS=60

# Hosted dashboard and the tunnel it reaches this API through (checked by make up / make doctor)
PUBLIC_API_URL=
PUBLIC_SITE_URL=
